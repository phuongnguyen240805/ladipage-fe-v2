{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "liora-landing-edge",
  "main": "./landing-edge-worker.ts",
  "compatibility_date": "2026-08-13",
  "observability": { "enabled": true },
  "vars": {
    "LANDING_ORIGIN_BASE_URL": "https://app.example.com",
    "FREE_SITE_DOMAIN": "sites.example.com",
    "LANDING_EDGE_FALLBACK_ENABLED": "true"
  },
  "kv_namespaces": [
    { "binding": "LANDING_ROUTES_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "r2_buckets": [
    { "binding": "LANDING_ARTIFACTS_R2", "bucket_name": "liora-landing-artifacts" }
  ],
  "analytics_engine_datasets": [
    { "binding": "LANDING_EDGE_ANALYTICS", "dataset": "landing_edge" }
  ]
}
