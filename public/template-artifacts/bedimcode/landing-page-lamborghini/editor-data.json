        \n        <!-- MAIN -->\n        <script data-inlined-from=\"assets/js/main.js\">const showMenu = (toggleId, navId) =>{\r\n    const toggle = document.getElementById(toggleId),\r\n    nav = document.getElementById(navId)\r\n\r\n    if(toggle && nav){\r\n        toggle.addEventListener('click', ()=>{\r\n            nav.classList.toggle('show')\r\n        })\r\n    }\r\n}\r\n\r\nshowMenu('nav__toggle','nav-menu')\r\n\r\n/*GSAP ANIMATION*/\r\ngsap.from('.home__title', {opacity: -1, duration: 1.5, delay:1})\r\ngsap.from('.home__img', {opacity: 0, duration: 1, delay:1, x: 100})\r\ngsap.from('.home__information', {opacity: 0, duration: 1, delay:1.2, y: -30})\r\n\r\ngsap.from('.box__medium', {opacity: 0, duration: 1.5, delay:1.3, y: -50})\r\ngsap.from('.box__small', {opacity: -1, duration: 1.5, delay:1.4, y: -50})</script>\n    \n\n</body>\n</html>","height":900,"editorViewportHeight":900,"preserveHtml":true,"mode":"iframe","autoResize":false},"label":"Mã HTML Bảo toàn Bố cục","frame":{"x":0,"y":0,"width":1280,"height":900,"zIndex":10,"rotate":0},"oid":"lp_html_code_1788350931337_m8d8k","instanceId":"oiid_1788350931337_m8d8k","domId":"block_1788350931337_m8d8k","componentName":"HtmlCodeBlock","parentId":"template_bedimcode-landing-page-lamborghini_section"}],"frame":{"x":0,"y":0,"width":1280,"height":900,"zIndex":1,"rotate":0},"oid":"lp_custom_section_1788350931337_b1muv","instanceId":"oiid_1788350931337_b1muv","domId":"block_1788350931337_b1muv","componentName":"CustomSectionBlock"}],"pageSettings":{"bgColor":"#ffffff","maxWidth":1280,"fontFamily":"Inter, sans-serif","primaryColor":"#65a30d","seoTitle":"Lamborghini Landing Page","seoDescription":"Landing page duoc tao bang visual editor.","canonicalUrl":"","slug":"lamborghini-landing-page","customDomain":"","pixelId":"","sandboxProvider":"local","sandboxId":"","sandboxPort":3000,"sandboxStatus":"local","sandboxUrl":"","previewPath":"/lamborghini-landing-page","funnelEnabled":false,"funnelFeatureFlag":"funnelx.welc