# ================== AUTH ==================
# legacy = POST /auth/login (+ captcha khi BE USE_SUPABASE_AUTH=false)
# supabase = Supabase SDK signIn + POST /auth/exchange (hoặc POST /auth/login email/password khi BE bật Supabase)
NEXT_PUBLIC_AUTH_MODE=legacy

NEXT_PUBLIC_SESSION_COOKIE_NAME=ladipage-session
NEXT_PUBLIC_FB_SESSION_COOKIE_NAME=ladipage-fb-session
NEXT_PUBLIC_SB_REFRESH_COOKIE_NAME=ladipage-sb-refresh

# Bật mock Facebook auth khi dev không có extension
NEXT_PUBLIC_AUTH_MOCK=true

# ================== FACEBOOK (cho /facebook-ads) ==================
NEXT_PUBLIC_FB_GRAPH_VERSION=v21.0

# FE — editor + iframe CMS
# --- Instatic editor same-origin (customer stays on Ladipage port) ---
NEXT_PUBLIC_LANDING_EDITOR=instatic
NEXT_PUBLIC_LANDING_PUBLISH_SOURCE=instatic-artifact
LANDING_PUBLISH_SOURCE=instatic-artifact
NEXT_PUBLIC_APP_URL=https://ladipage-fe-v2.vercel.app
NEXT_PUBLIC_INSTATIC_EDITOR_ORIGIN=https://instatic-editor.onrender.com
INSTATIC_REWRITE_TARGET_CMS=https://instatic-editor.onrender.com
# INSTATIC_REWRITE_TARGET_VITE=not-used-in-production

# ================== LANDING PUBLISH / DOMAIN ==================
# Tạm thời: chỉ dùng platform URL /p/{slug} (tắt Plan A free subdomain)
# Plan A (bật lại khi có zone CF / hosts test):
# LANDING_FREE_SUBDOMAIN_ENABLED=true
# NEXT_PUBLIC_LANDING_FREE_SUBDOMAIN_ENABLED=true
# FREE_SITE_DOMAIN=liora.app
# NEXT_PUBLIC_FREE_SITE_DOMAIN=liora.app
# FREE_SUBDOMAIN_DELIVERY=proxy
# LANDING_CUSTOM_DOMAIN_EDGE_ENABLED=false

# Plan B
# LANDING_CUSTOM_DOMAIN_EDGE_ENABLED=false

# prod: AI-SEO + lab scan qua Nest
NEXT_PUBLIC_AI_SEO_USE_NEST=true
NEXT_PUBLIC_AI_SEO_CHAT_USE_BFF=true
# ================== LANDING PUBLISH / DOMAIN ==================
LANDING_ORIGIN_URL=https://ladipage-fe-v2.vercel.app
LANDING_FREE_SUBDOMAIN_ENABLED=false
NEXT_PUBLIC_LANDING_FREE_SUBDOMAIN_ENABLED=false
FREE_SITE_DOMAIN=
NEXT_PUBLIC_FREE_SITE_DOMAIN=
LANDING_CUSTOM_DOMAIN_EDGE_ENABLED=true
CUSTOM_DOMAIN_CNAME_TARGET=ladipage.publicvm.com
CLOUDFLARE_SAAS_FALLBACK_ORIGIN=ladipage.publicvm.com
NEXT_PUBLIC_LANDING_CUSTOM_DOMAIN_EDGE_ENABLED=true
# prod: không bypass quota
LANDING_DOMAIN_BYPASS_QUOTA=false
NEXT_PUBLIC_LANDING_DOMAIN_BYPASS_QUOTA=false
NEXT_PUBLIC_CUSTOM_DOMAIN_CNAME_TARGET=ladipage.publicvm.com

# ecommerce Medusa
NEXT_PUBLIC_COMMERCE_USE_API=true
# prod: không MSW mock
NEXT_PUBLIC_API_MOCKING=false

# Ads Platform pilot gọi backend OAuth/worker; publish luôn tạo ở trạng thái tạm dừng.
NEXT_PUBLIC_ADS_PLATFORM_MODE=live