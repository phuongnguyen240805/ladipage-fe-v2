{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "ladipage",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-08-13",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "keep_vars": true,
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
}