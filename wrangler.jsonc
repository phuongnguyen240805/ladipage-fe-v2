{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "ladipage-fe",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-08-13",
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
}